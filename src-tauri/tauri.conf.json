{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SQL Internals Academy",
  "version": "0.1.0",
  "identifier": "dev.sqlinternals.academy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build -- --mode native",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "SQL Internals Academy",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; media-src 'self' blob: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/media/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "resources": {
      "resources/postgres/": "postgres/",
      "../web/public/media/": "media/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
