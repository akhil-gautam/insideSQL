  "narrative": {
    "northStar": "The Database Engine Workshop",
    "overview": "A quiet slate-blue workbench surrounds a separate charcoal mechanical illustration. White editing and assessment surfaces keep real SQL work readable; the exploded engine supplies depth and cinematic attention inside the lesson.\n\nThe journey uses local Space Grotesk and IBM Plex Mono, warm copper light, and ivory text. Six mechanically distinct chambers are inspectable as SQL text, parser, analyzer, rewriter, planner and executor. The assembly is a teaching metaphor; measured query evidence belongs to the workbench.",
    "keyCharacteristics": [
      "Slate-blue application chrome and white work surfaces.",
      "Scoped charcoal machinery, copper edges and ivory annotations.",
      "Real geometry with distinct internal structures for each stage.",
      "One shared scene for interactive exploration and frame-driven video."
    ],
    "rules": [
      {
        "name": "Scoped World",
        "body": "Keep the charcoal/copper palette inside the journey and its video. The surrounding workbench retains its slate-blue/white system.",
        "section": "colors"
      },
      {
        "name": "Readable Annotation",
        "body": "Render selected-stage labels as projected DOM text using the annotation roles; keep source names and input/output contracts readable outside the 3D canvas.",
        "section": "typography"
      },
      {
        "name": "Illustrated Evidence",
        "body": "Keep the “Illustrated mechanism” label visible. Geometry, signal packets and camera motion do not represent a measured PostgreSQL trace.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do retain the workbench palette and UI typography around the scoped cinematic journey.",
      "Do use different internal structures for the six engine stages; the shared casing is the metaphor.",
      "Do pair each inspection view with its input/output contract and text explanation.",
      "Do preserve Overview, keyboard stage selection, pause/reduced-motion behavior and the graphics fallback.",
      "Do distinguish illustrated mechanisms from PostgreSQL estimates and measured execution."
    ],
    "donts": [
      "Don’t extend the journey’s charcoal/copper treatment across the entire application.",
      "Don’t replace sharp DOM source annotations with rasterized text on geometry.",
      "Don’t add invented execution timings or measured row counts to the illustration.",
      "Don’t give video labels or rotors an independent animation clock."
    ]
  }
}
